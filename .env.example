# FinancialReport local settings. Copy to .env and edit. The app and Docker
# Compose both read this file; variables already set in the process
# environment always win.

# Local AI model tier. Only the selected tier's weights are downloaded.
# Sizes are weight download sizes, NOT RAM caps (inference needs extra
# memory):
#   low    qwen2.5:1.5b                ~0.99 GB
#   medium qwen2.5:7b-instruct-q3_K_M  ~3.81 GB
#   high   qwen2.5:14b-instruct-q3_K_L ~7.92 GB
FINREPORT_AI_TIER=low

# Ollama model per tier; change to any local model tag you prefer.
FINREPORT_AI_MODEL_LOW=qwen2.5:1.5b
FINREPORT_AI_MODEL_MEDIUM=qwen2.5:7b-instruct-q3_K_M
FINREPORT_AI_MODEL_HIGH=qwen2.5:14b-instruct-q3_K_L

# Web port on localhost (Compose binds 127.0.0.1 only).
FINREPORT_PORT=8010

# 'private' keeps your data, config and rules in the private bind mount.
FINREPORT_PROFILE=demo

# Owner of the private bind mount on Linux.
FINREPORT_UID=1000
FINREPORT_GID=1000

# Host folder holding private data (default: ./private).
# FINREPORT_PRIVATE_DIR=./private

# Native runs without Docker: point at a local Ollama to enable local AI.
# FINREPORT_AI_URL=http://127.0.0.1:11434
