# FinancialReport local settings. Copy to .env and edit. The app and Docker
# Compose both read this file; variables already set in the process
# environment always win.

# Local AI model tier. Only the selected tier's weights are downloaded.
# Sizes are weight download sizes, NOT RAM caps (inference needs extra
# memory):
#   low    qwen2.5-1.5b-instruct-q4_k_m.gguf  ~1.12 GB
#   medium Qwen2.5-7B-Instruct-Q3_K_M.gguf    ~3.81 GB
#   high   Qwen2.5-14B-Instruct-Q3_K_L.gguf   ~7.92 GB
FINREPORT_AI_TIER=low

# llama.cpp model filename per tier (a plain .gguf name; the server aliases
# each model to this name). Change a filename and its download URL together.
FINREPORT_AI_MODEL_LOW=qwen2.5-1.5b-instruct-q4_k_m.gguf
FINREPORT_AI_MODEL_MEDIUM=Qwen2.5-7B-Instruct-Q3_K_M.gguf
FINREPORT_AI_MODEL_HIGH=Qwen2.5-14B-Instruct-Q3_K_L.gguf

# Download URLs used by the one-off Compose model initializer (deploy-only).
# The defaults are pinned to the official Qwen and bartowski HuggingFace
# repos. Uncomment a line to serve that tier's weights from elsewhere.
# FINREPORT_AI_MODEL_URL_LOW=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/91cad51170dc346986eccefdc2dd33a9da36ead9/qwen2.5-1.5b-instruct-q4_k_m.gguf
# FINREPORT_AI_MODEL_URL_MEDIUM=https://huggingface.co/bartowski/Qwen2.5-7B-Instruct-GGUF/resolve/8911e8a47f92bac19d6f5c64a2e2095bd2f7d031/Qwen2.5-7B-Instruct-Q3_K_M.gguf
# FINREPORT_AI_MODEL_URL_HIGH=https://huggingface.co/bartowski/Qwen2.5-14B-Instruct-GGUF/resolve/05244aa5d871c661c80082a15d3bce44714d068d/Qwen2.5-14B-Instruct-Q3_K_L.gguf

# Web port on localhost (Compose binds 127.0.0.1 only).
FINREPORT_PORT=8010

# 'private' keeps your data, config and rules in the private bind mount.
FINREPORT_PROFILE=demo

# Owner of the private bind mount on Linux.
FINREPORT_UID=1000
FINREPORT_GID=1000

# Host folder holding private data (default: ./private).
# FINREPORT_PRIVATE_DIR=./private

# Native runs without Docker: point at a local llama.cpp server to enable
# local AI.
# FINREPORT_AI_URL=http://127.0.0.1:8080
